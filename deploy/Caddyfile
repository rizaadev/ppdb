{
	# Endpoint verifikasi agar Caddy hanya menerbitkan SSL untuk domain sekolah yang sah
	on_demand_tls {
		ask http://app:8080/internal/tls/verify
	}
}

# Object storage S3/MinIO HTTPS endpoint untuk presigned upload/preview berkas
s3.{$BASE_DOMAIN:s3.localhost} {
	request_body {
		max_size 25MB
	}
	reverse_proxy minio:9000
}

# Portal utama platform & subdomain tenant (*.domain-utama)
*.{$BASE_DOMAIN:localhost}, {$BASE_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy app:8080
}

# Custom domain instansi (spmb.sekolahabc.sch.id, pmbm.madrasahxyz.sch.id)
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy app:8080
}
